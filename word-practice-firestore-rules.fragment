// Merge inside the deployment's existing /databases/{database}/documents block.
// This only adds Word Practice (單字練習); do not replace all app rules.
// The deployed rules are not kept in this repo, so this fragment must be merged
// into them by hand before the feature can read or write Firestore.
function ownsWordPractice(uid) {
  return request.auth != null && request.auth.uid == uid
    && request.auth.token.email_verified == true
    && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
}
// Per-word practice state and AI CEFR estimates: a single document.
match /users/{uid}/wordPractice/state {
  allow read, write: if ownsWordPractice(uid);
}
// One document per homework (active, completed or abandoned).
match /users/{uid}/wordHomeworks/{homeworkId} {
  allow read, write: if ownsWordPractice(uid);
}
// IMPORTANT: Remove/narrow overlapping public or cross-user wildcard grants.
// Firestore grants access if ANY matching rule allows it.
