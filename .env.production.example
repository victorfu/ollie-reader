# Frontend production: copy to .env.production, then run npm run build.
# Real .env.production files are ignored by Git.

# Primary Firebase Project (Auth + Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Keep App Check debug tokens disabled in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Gemini client pacing (effective requests per minute)
VITE_GEMINI_CLIENT_RPM_BUDGET=4

# Set the deployed HTTPS base URLs, without endpoint paths.
# Defaults to the own Vercel server; override for another deployment.
# Leaving VITE_ETTS_API_BASE_URL empty uses VITE_API_BASE_URL for Edge TTS.
VITE_API_BASE_URL=https://server-one-xi-16.vercel.app
VITE_ETTS_API_BASE_URL=

# Supabase Storage: public/publishable key only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
