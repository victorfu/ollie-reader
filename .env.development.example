# Frontend development: copy to .env.development, then run npm run dev.
# Real .env.development files are ignored by Git.

# Primary Firebase Project (Auth + Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Gemini client pacing (effective requests per minute)
VITE_GEMINI_CLIENT_RPM_BUDGET=4

# Local Next.js server for general APIs and Edge TTS
VITE_API_BASE_URL=http://localhost:3000
VITE_ETTS_API_BASE_URL=http://localhost:3000

# Supabase Storage: public/publishable key only
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
