{
  "name": "ollie-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev --prefix server",
    "setup:server": "npm ci --prefix server",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ignore-pattern 'desktop/.venv/**' --ignore-pattern 'desktop/dist/**' --ignore-pattern 'desktop/build/**'",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "fetch-transcripts": "node scripts/fetch-transcripts.mjs",
    "build-cefr": "node scripts/build-cefr-levels.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/canvas-confetti": "^1.9.0",
    "cactus-needle": "0.3.0",
    "canvas-confetti": "^1.9.4",
    "daisyui": "^5.5.18",
    "firebase": "^12.9.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.13.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^29.1.1",
    "node-html-parser": "^7.0.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "lightningcss": "^1.33.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
