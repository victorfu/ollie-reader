EDGE_TTS_VOICE=en-US-AriaNeural
# Comma-separated additional browser origins, without paths or wildcards.
OLLIE_CORS_ORIGINS=

# General API version (defaults to the Python backend's 1.0.1 contract).
API_VERSION=1.0.1
# Firebase project used to verify client ID tokens (not an API key or private key).
FIREBASE_PROJECT_ID=
# Server-only OIKID login. Keep real values in .env.local / deployment secrets.
OIKID_USERNAME=
OIKID_PASSWORD=
