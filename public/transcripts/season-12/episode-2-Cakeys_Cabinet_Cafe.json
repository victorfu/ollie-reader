  },
  {
    "index": 354,
    "text": "♪ Ziti ♪"
  },
  {
    "index": 355,
    "text": "♪ Welcome to Pasta Paradise ♪"
  },
  {
    "index": 356,
    "text": "♪ Just look at all the different types ♪"
  },
  {
    "index": 357,
    "text": "♪ Yes, pasta shapes our world ♪"
  },
  {
    "index": 358,
    "text": "♪ Anything is pasta-ble ♪"
  },
  {
    "index": 359,
    "text": "♪ The sun rays shining are spaghetti ♪"
  },
  {
    "index": 360,
    "text": "♪ Ooh, that feels nice ♪"
  },
  {
    "index": 361,
    "text": "♪ A rigatoni rainbow ♪"
  },
  {
    "index": 362,
    "text": "♪ See that zebra? All ziti ♪"
